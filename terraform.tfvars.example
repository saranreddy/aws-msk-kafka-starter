# Example Terraform variables
# Copy this file to terraform.tfvars and adjust as needed

aws_region  = "us-east-1"
environment = "dev"
project_name = "msk-kafka-starter"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# Must have at least 2 AZs for MSK
availability_zones = ["us-east-1a", "us-east-1b"]

# NAT Gateway Configuration
# single_nat_gateway = true  (default) - Cost-optimized: ~$32/month, single point of failure
# single_nat_gateway = false - High-availability: ~$64/month for 2 AZs, no single point of failure
# Uncomment to enable per-AZ NAT gateways for production:
# single_nat_gateway = false

# Kafka Topic Configuration
kafka_topic_name               = "demo-topic"
kafka_topic_partitions         = 2
kafka_topic_replication_factor = 2
